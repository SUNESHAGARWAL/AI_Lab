# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql://app:app@localhost:5432/app
# Production (Railway) only: set to Neon's DIRECT (non-pooled, no "-pooler" in the
# host) connection string. DATABASE_URL above should be Neon's pooled string in
# production — migrations run over a different connection than runtime traffic
# because running them concurrently with the pool's own startup over a pooled
# (PgBouncer transaction-mode) connection crashes uvicorn outright. Leave unset
# locally; falls back to DATABASE_URL, which isn't pooled in local dev anyway.
MIGRATIONS_DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379/0

# App
# Production (Railway) must set this to "production" — default here is dev-only.
APP_ENV=development

# Public-demo hardening (apps/api/src/api/config.py) — MAX_QUERY_LENGTH and
# LIVE_QUERY_RATE_LIMIT_PER_HOUR already have sane defaults (2000, 5) and rarely need
# overriding. FRONTEND_ORIGIN is the one that MUST change in production: comma-separated
# list of origins CORSMiddleware allows, e.g.
# FRONTEND_ORIGIN=https://your-app.vercel.app,http://localhost:3000
# Defaults to the local frontend dev server so `just dev` needs no .env entry — never
# leave it at that default (or a wildcard) in production.
FRONTEND_ORIGIN=http://localhost:3000
MAX_QUERY_LENGTH=2000
LIVE_QUERY_RATE_LIMIT_PER_HOUR=5

# LLM gateway providers (see packages/llm/src/llm/registry.py) — required for
# scripts/smoke_gateway.py, otherwise the gateway falls back to whatever LiteLLM
# finds in the real environment. DeepSeek is currently the primary provider for
# every network tier (see docs/adr/0005-deepseek-primary-groq-free-fallback.md);
# Groq's free tier is the fallback. GEMINI_API_KEY is unused while Gemini is
# disabled in the registry. DEEPSEEK_API_KEY/GROQ_API_KEY aren't schema-enforced by
# either Settings class (litellm reads them directly) but are functionally required
# in production — every query fails without them.
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
