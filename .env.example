# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Redis
REDIS_URL=redis://localhost:6379/0

# App
APP_ENV=development

# LLM gateway free-tier providers (see packages/llm/src/llm/registry.py) —
# required for scripts/smoke_gateway.py, otherwise the gateway falls back to
# whatever LiteLLM finds in the real environment.
GROQ_API_KEY=
GEMINI_API_KEY=
